# Bidshield configuration — copy to `.env` and edit.
# Docker Compose reads `.env` automatically for interpolation; the API binary
# also loads it directly when run on the host (`cargo run -p api`).
# Values already present in the real environment always win over this file.
# NOTE: zecd endpoints are NOT listed here — inside Docker they are fixed
# to the compose network (http://auctioneer:...); on the host the binary
# defaults already point at 127.0.0.1. Set ZECD_URL/ZECD_HEALTH only when
# running the binary against a remote zecd.

# --- API server (host-dev paths; Docker ignores these) ---
BIND=0.0.0.0:8080
DB_PATH=data/bidshield.db
WEB_DIST=web/dist

# --- zecd credentials (must match the auctioneer container / zecd.conf) ---
ZECD_USER=auctioneer
ZECD_PASS=regtest-auctioneer-pw

# --- auction economics ---
CONF_TARGET=10
# Regtest is a demo: 3 confirmations instead of 10, so a bid settles in
# seconds. Public chains keep CONF_TARGET above.
REGTEST_CONF_TARGET=3
FEE_ZATS=10000
MIN_BID_ZATS=100000
MAX_BID_ZATS=10000000000000
POLL_SECS=2
MISSED_GRACE_SECS=120
MIN_DURATION_SECS=30
MAX_DURATION_SECS=2592000
# Regtest-only: seconds between blocks the API mines for the demo (regtest has
# no built-in miner). 0 disables the miner entirely.
MINER_INTERVAL_SECS=1

# --- auth / sessions ---
SESSION_TTL_SECS=604800
COOKIE_SECURE=0
# Split frontend (e.g. a Vercel-hosted SPA on its own origin): exact origin
# the API must allow cross-origin, with cookies. Empty = same-origin only.
# Requires COOKIE_SECURE=1 (cross-site cookies need SameSite=None + Secure).
# The frontend build gets the matching base URL via VITE_API_URL.
CORS_ORIGIN=

# --- security limits ---
RATE_AUTH_PER_MIN=20
RATE_WRITE_PER_MIN=30
RATE_READ_PER_MIN=240
AUTH_FAIL_MAX=10
AUTH_LOCKOUT_SECS=60
MAX_CONCURRENT_REQUESTS=64

# --- network profiles (multi-chain) ---
# The default profile is the regtest stack above (ZECD_URL / DB_PATH / ...);
# NETWORK names it (regtest | testnet | mainnet — display only, the chain
# itself is detected from zecd's getblockchaininfo).
NETWORK=regtest
#
# Testnet is opt-in and runs in LIGHT MODE: the auctioneer zecd (v0.9.0-rc1,
# NU7-era) follows the zec.rocks public lightwalletd — no local full node, no
# multi-day sync. The api's readiness probe talks to any public zebra
# JSON-RPC endpoint via NETWORK_TESTNET_ZEBRA_URL (QuickNode, GetBlock, or a
# local zebra-testnet from the testnet-fullnode profile). To enable:
# uncomment the lines below AND run
#   docker compose --profile testnet up -d
# then init the wallet (birthday must be <= the current chain tip; check it
# with: curl -s -X POST "$NETWORK_TESTNET_ZEBRA_URL" -H 'content-type:
# application/json' -d '{"jsonrpc":"2.0","id":1,"method":"getblockcount"}'):
#   docker compose run --rm --no-deps auctioneer-testnet
#     --datadir /var/lib/zecd --conf=/etc/zecd/zecd.toml init --wallet default --birthday <height>
#NETWORK_TESTNET_URL=http://auctioneer-testnet:18232/
#NETWORK_TESTNET_HEALTH=http://auctioneer-testnet:9233/readyz
#NETWORK_TESTNET_USER=auctioneer
#NETWORK_TESTNET_PASS=testnet-auctioneer-pw
#NETWORK_TESTNET_DB_PATH=data/bidshield-testnet.db
#NETWORK_TESTNET_ZEBRA_URL=https://your-zebra-testnet-json-rpc.example/
#
# Mainnet is opt-in: it ships as a compose profile but is never started by
# default (a full mainnet sync needs tens of GB of disk and days of time).
# To enable: uncomment the lines below AND run
#   docker compose --profile mainnet up -d
# then init the wallet: docker compose run --rm --no-deps auctioneer-mainnet
#   --datadir /var/lib/zecd --conf=/etc/zecd/zecd.toml init --wallet default --birthday <height>
#NETWORK_MAINNET_URL=http://auctioneer-mainnet:18232/
#NETWORK_MAINNET_HEALTH=http://auctioneer-mainnet:9233/readyz
#NETWORK_MAINNET_USER=auctioneer
#NETWORK_MAINNET_PASS=mainnet-auctioneer-pw
#NETWORK_MAINNET_DB_PATH=data/bidshield-mainnet.db
#NETWORK_MAINNET_ZEBRA_URL=http://zebra-mainnet:18234
