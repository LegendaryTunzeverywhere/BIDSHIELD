.env
.env.*
!.env.example
!.env.example.*
secrets/
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account.json

# --- chain / wallet material ---
# Seed phrases for the testnet wallets live next to their compose profile.
*.mnemonic
wallet.dat
*.generated.toml

# --- docker build context artifacts (zecd binaries are fetched, not built) ---
docker/zecd/zecd
docker/zecd/zecd-*
docker/zecd/*.tar.gz

# --- e2e / spike scratch ---
e2e/.spike-*.json

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

